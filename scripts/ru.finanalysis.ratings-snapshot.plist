<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ежедневный снимок рейтингов. Метод источника отдаёт только последнее
  значение, а история рейтингов у подписки закрыта (`get_emitent_ratings_new`
  отвечает «invalid resource name»), — без снимков истории понижений
  не будет никогда.

  Установка (агент пользователя, не системный демон):

      cp scripts/ru.finanalysis.ratings-snapshot.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ru.finanalysis.ratings-snapshot.plist
      launchctl kickstart -p gui/$(id -u)/ru.finanalysis.ratings-snapshot   # проверка

  Снятие:

      launchctl bootout gui/$(id -u)/ru.finanalysis.ratings-snapshot

  **Если машина спала, launchd выполняет пропущенный календарный запуск при
  пробуждении** — на это и рассчитано: снимок дня не перезаписывается, поэтому
  запуск после пробуждения и запуск по расписанию дают один файл, а не два.
  **Если машина была выключена, запуск дня теряется**: `RunAtLoad` выключен,
  и launchd календарный запуск после загрузки не догоняет. Отсюда время —
  утро рабочего дня, когда машина включена.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ru.finanalysis.ratings-snapshot</string>

  <!-- **Снимок котировок остановлен 22.09.2026, снимок рейтингов остался.**
       ISS Московской биржи отдаёт ту же историю торгов глубже (883 дня
       у выпуска против сорока дней у агрегатора), бесплатно и с уже
       посчитанным Z-спредом, — и копить 383 МБ в день ради второго источника
       того же незачем. История рейтингов у подписки закрыта, поэтому снимок
       рейтингов остаётся единственным путём к ней. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>scripts/ratings_snapshot.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/sk/Work/fin-analysis</string>

  <!-- **11:30 по рабочим дням** (решение владельца 25.09.2026; прежде 19:30,
       но вечером машина выключена, а выключенная машина запуск теряет).
       Снимок застаёт действия, опубликованные накануне; действия выходных
       застанет снимок понедельника.
       **Агент — страховка, а не основной путь.** Снимает рейтинги ежедневный
       прогон в 10:00, первой доставкой: 977 эмитентов при 30 запросах
       в минуту — около 33 минут (замер 25.09.2026: 660 запросов за 21 минуту
       44 секунды). С повтором упавших стадий (пауза 20 минут) прогон
       доходит до 11:15–11:30, поэтому агент, застав прогон идущим, ждёт
       снятия его замка (`finlib.run_lock`) и в Cbonds до того не ходит —
       два процесса к источнику одновременно не ходят. Снимок дня готов — агент ничего не делает;
       прогон упал — агент добирает остаток: ответ по каждому эмитенту
       прогон уже положил на диск отдельно, и в сеть идут только недошедшие.
       Пять записей: `StartCalendarInterval` принимает массив словарей,
       Weekday 1 — понедельник, 5 — пятница. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>11</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>11</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>11</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>11</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>11</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <!-- Журнал прогона: без него «снимка за день нет» не отличить
       от «прогон не запускался». -->
  <key>StandardOutPath</key>
  <string>/Users/sk/Work/fin-analysis/data/output/ratings_snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sk/Work/fin-analysis/data/output/ratings_snapshot.log</string>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
