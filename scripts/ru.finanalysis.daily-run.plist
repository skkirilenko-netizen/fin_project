<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ежедневный прогон целиком: доставка, маршрут, история корзин, список,
  отчёт изменений. Один агент, а не пять: расход запросов живёт в процессе,
  и разнесённые по скриптам доставки о нём друг друга не знают.

  Установка (агент пользователя, не системный демон):

      cp scripts/ru.finanalysis.daily-run.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ru.finanalysis.daily-run.plist
      launchctl kickstart -p gui/$(id -u)/ru.finanalysis.daily-run   # проверка

  Снятие:

      launchctl bootout gui/$(id -u)/ru.finanalysis.daily-run

  **Время — 10:00 по рабочим дням** (решение владельца 24.09.2026). Отчёт
  изменений читают утром, и прогон должен быть готов к этому часу, а не
  накануне вечером. Выходные пропускаются намеренно: торгов в субботу
  и воскресенье нет, рейтинговых действий тоже, и прогон в эти дни писал бы
  точку истории, ничем не отличающуюся от пятничной.

  **Снимок рейтингов остаётся отдельным агентом — в 10:30 по рабочим дням**
  (перенесён с 19:30 решением владельца 25.09.2026: вечером машина
  выключена). Он единственный путь к истории рейтингов, и пропущенный день
  не восстанавливается ничем. Если к 10:00 снимка дня нет, прогон делает
  его сам первой доставкой; ответ по каждому эмитенту ложится на диск
  отдельно, и агент в 10:30 берёт снятое оттуда. **Закончить к 10:30 прогон
  не успевает**: 977 эмитентов при 30 запросах в минуту — около 33 минут,
  и хвост снимка два процесса запрашивают одновременно.

  **Пропущенный запуск launchd выполняет только после сна, не после
  выключения.** Две ситуации ведут себя по-разному:

  - **машина спала** (крышка закрыта, сон): пропущенный календарный запуск
    выполняется сразу при пробуждении. В 14:00 прогон пойдёт за 10:00;
  - **машина была выключена**: запуск дня **теряется**. При загрузке агент
    загружается заново, но `RunAtLoad` выключен, и календарный запуск,
    пришедшийся на выключенную машину, launchd не догоняет. Прогон дня
    не состоится, пока его не запустить руками (`launchctl kickstart`).

  Поэтому судить о свежести данных надо по журналу прогона (`routing_run`),
  а не по расписанию: отсутствие строки за день означает, что прогона
  не было.

  Прогон от этого не портится: история корзин пишется с датой прогона,
  а повторный прогон того же дня переписывает свою точку, а не добавляет
  вторую. Отчёт изменений при этом называет доставки дня и их состояние —
  «изменений нет» при недошедшей доставке и при полной выглядят одинаково,
  и потому здоровье источников стоит в начале отчёта.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ru.finanalysis.daily-run</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>python</string>
    <string>scripts/daily_run.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/sk/Work/fin-analysis</string>

  <!-- Пять записей, а не одна с перечнем дней: `StartCalendarInterval`
       принимает массив словарей, и каждый день объявляется своим.
       Weekday: 1 — понедельник, 5 — пятница. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>2</integer>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>3</integer>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>4</integer>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>5</integer>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <!-- Журнал прогона: без него «отчёта за день нет» не отличить
       от «прогон не запускался». Сам прогон пишет журнал и в базу
       (`routing_run`), а этот файл — то, что сказал процесс. -->
  <key>StandardOutPath</key>
  <string>/Users/sk/Work/fin-analysis/data/output/daily_run.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/sk/Work/fin-analysis/data/output/daily_run.log</string>

  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
