# Образец .env. Скопировать в .env и заполнить. Сам .env в репозиторий не идёт.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=findb
DB_USER=
DB_PASSWORD=

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:30b-a3b
EMBED_MODEL=bge-m3

# Государственный информационный ресурс бухгалтерской отчётности ФНС.
# Домен уже менялся (bo.nalog.ru -> bo.nalog.gov.ru), поэтому задаётся здесь.
GIRBO_BASE_URL=https://bo.nalog.gov.ru
# Контакт в User-Agent: по нему владелец источника сможет связаться.
GIRBO_CONTACT=your.name@example.com

# Cbonds: нормализованная отчётность по ИНН. Доступ платный и именной.
# Без логина и пароля клиент в сеть не идёт и говорит об этом; чтение
# сохранённых ответов из data/raw/cbonds/ при этом работает.
CBONDS_BASE_URL=https://ws.cbonds.info/services/json
CBONDS_LOGIN=
CBONDS_PASSWORD=
